#!/bin/sh
# HEY-W09 (荣耀平板8, khaje) Debian 引导 initrd 的 init
# 职责: 基础挂载 -> 加载 WiFi -> 找 Debian 根分区 -> 挂载 -> switch_root -> systemd
# busybox 由 build-busybox.sh 交叉编译(静态), 打进 initrd

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

# busybox applet 符号链接
if [ -x /bin/busybox ]; then
    /bin/busybox --install -s /bin 2>/dev/null || true
fi

echo "[initrd] HEY-W09 Debian boot initrd starting"

# ---------- 1. 基础文件系统 ----------
mkdir -p /proc /sys /dev /dev/pts /dev/shm /newroot /tmp /run /etc

echo "[initrd] mounting proc -> /proc"
mount -t proc proc /proc

echo "[initrd] mounting sysfs -> /sys"
mount -t sysfs sysfs /sys

echo "[initrd] mounting /dev"
if mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
    echo "[initrd] devtmpfs mounted at /dev"
else
    echo "[initrd] devtmpfs unavailable, falling back to tmpfs + mdev"
    mount -t tmpfs tmpfs /dev
    mkdir -p /dev/pts /dev/shm
    echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null
    mdev -s 2>/dev/null
fi
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true

# ---------- 2. 加载 WiFi 驱动 ----------
# SM6225 (khaje) WiFi 常见: ATH10K_SNOC / WCNSS / ATH11K_AHB / WCN36XX
echo "[initrd] loading WiFi driver modules"
for m in \
    qcom_wcnss_pil qcom_wcnss_ctrl \
    ath10k_snoc ath10k_core ath10k_pci \
    ath11k_ahb ath11k ath11k_pci \
    wcn36xx; do
    if modprobe "$m" 2>/dev/null; then
        echo "[initrd] loaded WiFi module: $m"
        break
    fi
done

# ---------- 3. 定位 Debian 根分区 ----------
ROOT_DEV=""
find_root() {
    # 内核 cmdline 显式 root= 优先
    for arg in $(cat /proc/cmdline 2>/dev/null); do
        case "$arg" in
            root=*)
                cand="${arg#root=}"
                [ -b "$cand" ] && ROOT_DEV="$cand" && return 0
                ;;
        esac
    done
    # PARTLABEL / LABEL = deepin
    for d in /dev/sd[a-z]* /dev/mmcblk* /dev/block/sd[a-z]* /dev/disk/by-partlabel/*; do
        [ -b "$d" ] || continue
        case "$(blkid "$d" 2>/dev/null)" in
            *PARTLABEL=\"debian\"*|*LABEL=\"debian\"*|*PARTLABEL=\"deepin\"*|*LABEL=\"deepin\"*|*PARTLABEL=\"linux\"*)
                ROOT_DEV="$d" && return 0
                ;;
        esac
    done
    # 兜底: 含 /etc/debian-version 或 /etc/os-release 标记的 ext4 分区
    for d in /dev/sd[a-z]* /dev/mmcblk* /dev/block/sd[a-z]*; do
        [ -b "$d" ] || continue
        if blkid "$d" 2>/dev/null | grep -q 'TYPE="ext4"'; then
            if mkdir -p /probe && mount -t ext4 -o ro "$d" /probe 2>/dev/null; then
                if [ -f /probe/etc/debian-version ] || [ -f /probe/etc/os-release ]; then
                    ROOT_DEV="$d"; umount /probe 2>/dev/null; return 0
                fi
                umount /probe 2>/dev/null
            fi
        fi
    done
    return 1
}

find_root
if [ -z "$ROOT_DEV" ]; then
    echo "[initrd] ERROR: cannot find Debian root partition"
    echo "[initrd] available block devices:"
    ls -l /dev/sd* /dev/mmcblk* /dev/block/* 2>/dev/null
    exec /bin/sh
fi
echo "[initrd] root device: $ROOT_DEV"

# ---------- 4. 挂载根文件系统 (ext4 / f2fs) ----------
case "$(blkid "$ROOT_DEV" 2>/dev/null)" in
    *f2fs*) mount -t f2fs "$ROOT_DEV" /newroot ;;
    *)      mount -t ext4  "$ROOT_DEV" /newroot ;;
esac
[ -d /newroot/etc ] || { echo "[initrd] ERROR: no /etc on root"; exec /bin/sh; }

# ---------- 5. 迁移挂载点并 switch_root ----------
mount --move /dev /newroot/dev 2>/dev/null || true
mount --move /proc /newroot/proc 2>/dev/null || true
mount --move /sys /newroot/sys 2>/dev/null || true
mount --move /dev/pts /newroot/dev/pts 2>/dev/null || true
mount --move /tmp /newroot/tmp 2>/dev/null || true

echo "[initrd] switching root -> $ROOT_DEV (/sbin/init)"
exec switch_root /newroot /sbin/init
